{
  "name": "my-home-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ant-design/icons": "5.2.6",
    "antd": "^5.11.5",
    "axios": "^1.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.45.4",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.14.2",
    "react-scripts": "5.0.1",
    "styled-components": "^6.0.7",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "src/components/**",
          "src/pages/**"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "paths": [
                {
                  "name": "axios",
                  "message": "API 호출은 apis/와 queries/ 훅을 통해서만 합니다."
                },
                {
                  "name": "react-query",
                  "message": "서버 상태는 queries/의 훅으로만 다룹니다."
                }
              ],
              "patterns": [
                {
                  "group": [
                    "apis/*",
                    "!apis/errors"
                  ],
                  "message": "화면 코드는 queries/ 훅을 쓰고, apis/에서는 apis/errors만 가져옵니다."
                },
                {
                  "group": [
                    "app/*",
                    "!app/routes"
                  ],
                  "message": "화면 코드는 app/에서 app/routes만 가져옵니다."
                }
              ]
            }
          ]
        }
      },
      {
        "files": [
          "src/domain/**",
          "src/types/**",
          "src/lib/**"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "paths": [
                {
                  "name": "react",
                  "message": "domain·types·lib는 React에 의존하지 않습니다."
                },
                {
                  "name": "antd",
                  "message": "domain·types·lib는 UI 라이브러리에 의존하지 않습니다."
                },
                {
                  "name": "axios",
                  "message": "domain·types·lib는 HTTP에 의존하지 않습니다."
                },
                {
                  "name": "react-query",
                  "message": "domain·types·lib는 서버 상태에 의존하지 않습니다."
                }
              ],
              "patterns": [
                {
                  "group": [
                    "app/*",
                    "pages/*",
                    "components/*",
                    "state/*",
                    "queries/*",
                    "apis/*"
                  ],
                  "message": "domain·types·lib는 상위 레이어를 가져오지 않습니다."
                }
              ]
            }
          ]
        }
      },
      {
        "files": [
          "src/apis/**",
          "src/queries/**"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "app/*",
                    "pages/*",
                    "components/*",
                    "state/*"
                  ],
                  "message": "apis·queries는 화면·상태 레이어를 가져오지 않습니다."
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^axios$": "axios/dist/node/axios.cjs"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^13.0.0",
    "@testing-library/user-event": "^13.2.1",
    "@types/jest": "^27.0.1",
    "@types/node": "^16.7.13",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/testing-library__jest-dom": "5.14.9",
    "eslint": "8.54.0",
    "eslint-config-react-app": "7.0.1",
    "prettier": "3.9.10",
    "typescript": "^4.4.2"
  }
}
